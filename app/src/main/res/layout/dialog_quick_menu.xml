<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ ĐƯỜNG THỌ 1080P MASTER"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialogCloseBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/text_muted"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- CHẾ ĐỘ HIỂN THỊ: MOBILE ⇋ WEB PC               -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#152136"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📱 GIAO DIỆN HIỂN THỊ"
                android:textColor="#38bdf8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Nút chọn Mobile -->
            <TextView
                android:id="@+id/btnUiMobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_gradient"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Mobile (Khuyên dùng)"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- Nút chọn PC -->
            <TextView
                android:id="@+id/btnUiDesktop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1e293b"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Bản PC"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- PHONG CÁCH GIAO DIỆN EXTENSION (THEME CHOOSER) -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#152136"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎨 PHONG CÁCH EXTENSION"
                android:textColor="#c084fc"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Nút chọn Chuẩn Dola -->
            <TextView
                android:id="@+id/btnThemeNativeDola"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_gradient"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Chuẩn Dola"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- Nút chọn Tùy Biến Pro -->
            <TextView
                android:id="@+id/btnThemeCustomPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1e293b"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Tùy Biến Pro"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- NÚT TẢI ẢNH THAM CHIẾU TỪ ĐIỆN THOẠI -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickUploadImage"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#0284c7"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="📸 Tải ảnh tham chiếu (Thư viện / Tệp máy)"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="#ffffff" />

        <!-- ============================================== -->
        <!-- MỤC 1: STUDIO TẠO VIDEO 15S - 20S - 30S (FAST) -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#152136"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎬 TẠO VIDEO 15s - 20s - 30s (FAST MODE)"
                    android:textColor="#38bdf8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Badge Fast Mode -->
                <TextView
                    android:id="@+id/tvModeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#22c55e"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="⚡ FAST"
                    android:textColor="#ffffff"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ô nhập / dán Prompt -->
            <EditText
                android:id="@+id/etCreatePrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#0b1220"
                android:gravity="top|start"
                android:hint="Dán prompt kịch bản tạo video vào đây..."
                android:minLines="2"
                android:maxLines="4"
                android:padding="10dp"
                android:textColor="@color/text_light"
                android:textColorHint="#64748b"
                android:textSize="12sp" />

            <!-- Chọn thời lượng: 15s, 20s hoặc 30s -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời lượng:"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <!-- Nút 15s -->
                <TextView
                    android:id="@+id/btnDuration15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_gradient"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="⏱️ 15s"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <!-- Nút 20s -->
                <TextView
                    android:id="@+id/btnDuration20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1e293b"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="⏱️ 20s"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <!-- Nút 30s -->
                <TextView
                    android:id="@+id/btnDuration30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1e293b"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="⏱️ 30s"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nút Bấm Tạo Video (Create Video) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTriggerCreateVideo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_gradient"
                android:text="🚀 TẠO VIDEO (CREATE VIDEO)"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <!-- ============================================== -->
        <!-- MỤC 2: QUÉT NGẦM & TẢI VIDEO VÀO THƯ VIỆN      -->
        <!-- ============================================== -->
        <!-- Nút Bật / Tắt Quét Video Ngầm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1a2333"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quét video ngầm khi cuộn trang"
                    android:textColor="@color/text_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kéo lướt đến đâu gom video đến đó"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAutoScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:useMaterialThemeColors="true" />
        </LinearLayout>

        <!-- Trạng thái số lượng video có thể tải & Nút Đặt lại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialogVideoStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Sẵn sàng tải: 0 video"
                android:textColor="@color/text_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnResetVideoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#27272a"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="🔄 Đặt lại (0)"
                android:textColor="#f43f5e"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút Tải tất cả vào Thư viện -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogBtnDownloadAll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_gradient"
            android:text="⚡ TẢI HÀNG LOẠT VÀO THƯ VIỆN"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#20ffffff" />

        <!-- ============================================== -->
        <!-- MỤC 3: HỆ THỐNG & TÁC GIẢ                       -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnReload"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🔄 Tải lại trang"
                android:textColor="@color/text_light"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="#4038bdf8" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <!-- Nút Thông tin tác giả & Cảnh báo -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnAbout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="ℹ️ Tác giả (Genpixo)"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
