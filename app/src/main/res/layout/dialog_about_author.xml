<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Logo & Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/aboutAppLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerHorizontal="true"
            android:src="@drawable/ic_app_icon_pro" />

        <TextView
            android:id="@+id/aboutCloseBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- App Title & Version -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="ĐƯỜNG THỌ DOLA MASTER"
        android:textColor="@color/primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Phiên bản 2.5 Ultimate 1080P Pro"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#2038bdf8" />

    <!-- Giới thiệu tính năng -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💡 GIỚI THIỆU TÍNH NĂNG"
        android:textColor="@color/text_light"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="3dp"
        android:text="• Tải video chất lượng cao 1080P Master không logo watermark.\n• Tự động gom video khi cuộn lướt màn hình và tải hàng loạt.\n• Lưu trực tiếp vào Thư viện (Bộ sưu tập) điện thoại.\n• Ép tạo video 15s - 20s - 30s Fast Mode chuẩn chuyên nghiệp."
        android:textColor="#cbd5e1"
        android:textSize="12sp" />

    <!-- Cảnh báo & Bảo mật -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#1aef4444"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ CẢNH BÁO &amp; BẢO MẬT"
            android:textColor="#f87171"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ứng dụng chỉ sử dụng hỗ trợ sáng tạo nội dung cá nhân hợp pháp. Vui lòng tôn trọng quyền sở hữu trí tuệ của tác giả. Mọi dữ liệu đăng nhập và cookie đều được mã hóa lưu trữ cục bộ 100% trên máy của bạn, hoàn toàn an toàn và bảo mật."
            android:textColor="#fca5a5"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#2038bdf8" />

    <!-- Tác giả & Kênh liên hệ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👨‍💻 TÁC GIẢ &amp; HỖ TRỢ"
        android:textColor="@color/text_light"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Nút mở Website genpixo.com -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenWebsite"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_gradient"
        android:text="🌐 Website: Genpixo.com"
        android:textColor="#ffffff"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="12dp" />

    <!-- Nút liên hệ Zalo Đường Thọ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenZalo"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="💬 Zalo: Đường Thọ (0934.415.387)"
        android:textColor="#38bdf8"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:strokeColor="#38bdf8"
        app:strokeWidth="1.5dp" />

</LinearLayout>
